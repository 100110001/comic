{
  "name": "comic-backend",
  "version": "1.0.0",
  "description": "Comic app backend API",
  "main": "dist/server.js",
  "scripts": {
    "predev": "npm run stop",
    "dev": "nodemon --exec ts-node src/server.ts",
    "stop": "ts-node src/scripts/kill-port.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "prettier --check \"src/**/*.ts\" && eslint src --max-warnings=0 && tsc --noEmit",
    "fix": "eslint src --fix --max-warnings=0 && prettier --write \"src/**/*.ts\"",
    "test": "npm run build && node --test tests/*.test.cjs",
    "setup": "npm run db:init && npm run comics:sync",
    "setup:waifu2x": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-waifu2x.ps1",
    "db:init": "ts-node src/db/init.ts",
    "comics:sync": "ts-node src/scripts/sync.ts",
    "comics:organize": "ts-node src/scripts/organize.ts",
    "comics:fix-chapter-order": "ts-node src/scripts/fix-chapter-order.ts",
    "cache:clear": "ts-node src/scripts/clear-cache.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "image-size": "^1.2.1",
    "ioredis": "^5.11.1",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.5",
    "prettier": "^3.9.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.9",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
