{
  "name": "comic-backend",
  "version": "1.0.0",
  "description": "Comic app backend API",
  "main": "dist/server.js",
  "scripts": {
    "predev": "ts-node src/scripts/kill-port.ts",
    "dev": "nodemon --exec ts-node src/server.ts",
    "stop": "ts-node src/scripts/kill-port.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "setup": "ts-node src/db/init.ts && ts-node src/scripts/scan.ts && ts-node src/scripts/seed.ts && ts-node src/scripts/clear-cache.ts --optional",
    "clear-cache": "ts-node src/scripts/clear-cache.ts",
    "reorganize-chapters": "ts-node src/scripts/reorganize-chapters.ts",
    "flatten-original": "ts-node src/scripts/flatten-original.ts",
    "fix-chapter-order": "ts-node src/scripts/fix-chapter-order.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix --max-warnings=0",
    "setup:waifu2x": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-waifu2x.ps1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "image-size": "^1.2.1",
    "ioredis": "^5.11.1",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.5",
    "prettier": "^3.9.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.9",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
